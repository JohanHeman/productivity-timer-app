<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProductivityTimer.Views.DailyHabitPage"
             Title="DailyHabitPage"
             x:Name="DailyHabitPageRoot">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B1020" Offset="0.0" />
            <GradientStop Color="#111827" Offset="0.5" />
            <GradientStop Color="#1F2937" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <VerticalStackLayout Spacing="24" Padding="40,80" HorizontalOptions="Center" WidthRequest="460">
        <Label 
            Text="Daily Habit Tracker" 
            FontSize="28" 
            FontAttributes="Bold" 
            TextColor="#ffffff"
            HorizontalOptions="Center"/>
        <Entry 
            Text="{Binding HabitName}" 
            Placeholder="Enter habit name" 
            HeightRequest="48"
            WidthRequest="360"
            FontSize="18"
            BackgroundColor="#222b3a"
            PlaceholderColor="#9ca3af"
            TextColor="#ffffff"
            Margin="0,20,0,0"
            HorizontalOptions="Center"/>
        <Grid WidthRequest="220" HeightRequest="50" HorizontalOptions="Center" Margin="0,12,0,0">
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4338CA" Offset="0.0" />
                        <GradientStop Color="#0F766E" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#66000000" Offset="0,6" Radius="12" Opacity="0.7" />
                </Border.Shadow>
            </Border>
            <Button
                Text="Add Habit"
                Command="{Binding AddDailyHabitCommand}"
                Style="{StaticResource GradientButtonText}"
                />
        </Grid>

            <CollectionView ItemsSource="{Binding DailyHabits}" WidthRequest="420">
                <!--inside this block we decide how each item will be displayed on the list-->
                <CollectionView.ItemsLayout>
                    <!--spacing between items-->
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!--this is the actual item that will be displayed on the list and 
                        gets repeated for each item in the list-->
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12" Margin="0,0,0,0">
                            <Border.Background>
                                <SolidColorBrush Color="#222b3a" />
                            </Border.Background>
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                          VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       TextColor="White"
                                       FontSize="16"
                                       WidthRequest="130"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       VerticalOptions="Center">
                                       <!--isEditing true, show entry, false show label-->
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="IsVisible" Value="False" /> <!--changes visibility of entry and label-->
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Entry Grid.Column="1"
                                       Text="{Binding EditableName, Mode=TwoWay}"
                                       TextColor="White"
                                       FontSize="16"
                                       WidthRequest="130"
                                       BackgroundColor="Transparent"
                                       IsVisible="False"
                                       VerticalOptions="Center">
                                       <!--isEditing true, show entry, false show label-->
                                    <Entry.Triggers>
                                        <DataTrigger TargetType="Entry" Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="IsVisible" Value="True" /> <!--changes visibility of entry and label-->
                                        </DataTrigger>
                                    </Entry.Triggers>
                                </Entry>
                                <Label Grid.Column="2"
                                       Text="{Binding Streak}"
                                       TextColor="#9ca3af"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <!-- In DataTemplate, item context is DailyHabitRow; x:Reference reaches the VM that is set as bindingcontext in the code behind, and CommandParameter passes current row -->
                                <Button Grid.Column="3"
                                        Text="Update"
                                        Command="{Binding Source={x:Reference DailyHabitPageRoot}, Path=BindingContext.UpdateHabitCommand}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource GradientButtonText}"
                                        VerticalOptions="Center"
                                        HeightRequest="34"
                                        WidthRequest="64"
                                        Padding="6,4" />
                                <Button Grid.Column="4"
                                        Text="Remove"
                                        Command="{Binding Source={x:Reference DailyHabitPageRoot}, Path=BindingContext.RemoveHabitCommand}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource GradientButtonText}"
                                        VerticalOptions="Center"
                                        HeightRequest="34"
                                        WidthRequest="70"
                                        Padding="6,4" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid WidthRequest="220" HeightRequest="50" HorizontalOptions="Center">
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4338CA" Offset="0.0" />
                            <GradientStop Color="#0F766E" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#66000000" Offset="0,6" Radius="12" Opacity="0.7" />
                    </Border.Shadow>
                </Border>
                <Button
                    Text="Home"
                    Style="{StaticResource GradientButtonText}"
                    Command="{Binding Source={x:Reference DailyHabitPageRoot}, Path=BindingContext.NavigateHomeCommand}" />
            </Grid>


    </VerticalStackLayout>
</ContentPage>