<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProductivityTimer.Views.DailyHabitPage"
             Title="DailyHabitPage">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B1020" Offset="0.0" />
            <GradientStop Color="#111827" Offset="0.5" />
            <GradientStop Color="#1F2937" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <VerticalStackLayout Spacing="24" Padding="40,80" HorizontalOptions="Center" WidthRequest="340">
        <Label 
            Text="Daily Habit Tracker" 
            FontSize="28" 
            FontAttributes="Bold" 
            TextColor="#ffffff"
            HorizontalOptions="Center"/>
        <Entry 
            Text="{Binding HabitName}" 
            Placeholder="Enter habit name" 
            HeightRequest="48"
            WidthRequest="280"
            FontSize="18"
            BackgroundColor="#222b3a"
            PlaceholderColor="#9ca3af"
            TextColor="#ffffff"
            Margin="0,20,0,0"
            HorizontalOptions="Center"/>
        <Grid WidthRequest="220" HeightRequest="50" HorizontalOptions="Center" Margin="0,12,0,0">
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4338CA" Offset="0.0" />
                        <GradientStop Color="#0F766E" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#66000000" Offset="0,6" Radius="12" Opacity="0.7" />
                </Border.Shadow>
            </Border>
            <Button
                Text="Add Habit"
                Command="{Binding AddDailyHabitCommand}"
                Style="{StaticResource GradientButtonText}"
                />
        </Grid>

            <CollectionView ItemsSource="{Binding DailyHabits}">
                <!--inside this block we decide how each item will be displayed on the list-->
                <CollectionView.ItemsLayout>
                    <!--spacing between items-->
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!--this is the actual item that will be displayed on the list and 
                        gets repeated for each item in the list-->
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12" Margin="0,0,0,0">
                            <Border.Background>
                                <SolidColorBrush Color="#222b3a" />
                            </Border.Background>
                            <Label Text="{Binding Name}" TextColor="White" FontSize="16" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

    </VerticalStackLayout>
</ContentPage>